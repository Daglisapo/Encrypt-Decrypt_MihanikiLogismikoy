<?xml version="1.0" encoding="UTF-8"?>

<!-- Καρτέλα «Αρχεία»: ENC-04, ENC-05, ENC-06, ENC-10, ENC-11 -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gr.ihu.omada12.crypto.controller.encryption.FileCryptoController"
      styleClass="screen" spacing="12">
    <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

    <Label fx:id="dropLabel" styleClass="drop-zone, drop-zone-large" maxWidth="Infinity"/>
    <HBox spacing="8">
        <Button text="%enc.file.chooseFiles" onAction="#chooseFiles"/>
        <Button text="%enc.file.chooseFolder" onAction="#chooseFolder"/>
    </HBox>
    <ListView fx:id="fileList" prefHeight="150" VBox.vgrow="ALWAYS"/>

    <GridPane hgap="10" vgap="8">
        <Label text="%enc.password" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <PasswordField fx:id="passwordField" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Label text="%enc.confirmPassword" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <PasswordField fx:id="confirmField" prefWidth="280" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Label text="%enc.file.confirmHint" styleClass="muted" GridPane.columnIndex="2" GridPane.rowIndex="1"/>
    </GridPane>

    <HBox spacing="8" alignment="CENTER_LEFT">
        <HBox fx:id="actions" spacing="8">
            <Button text="%enc.encrypt" onAction="#encrypt" styleClass="primary"/>
            <Button text="%enc.decrypt" onAction="#decrypt"/>
        </HBox>
        <ProgressBar fx:id="progressBar" progress="0" prefWidth="260"/>
        <Button fx:id="cancelButton" text="%common.cancel"/>
    </HBox>
    <Label fx:id="statusLabel" styleClass="status"/>
</VBox>
