<?xml version="1.0" encoding="UTF-8"?>

<!-- Καρτέλα «Ιστορικό»: APP-09, APP-10 -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gr.ihu.omada12.crypto.controller.general.HistoryController"
      styleClass="screen" spacing="10">
    <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

    <Label fx:id="disabledLabel" text="%history.disabled" styleClass="warning"/>
    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="filter-bar">
        <Label text="%history.module"/>
        <ComboBox fx:id="moduleFilter" prefWidth="200"/>
        <CheckBox fx:id="failuresOnly" text="%history.failuresOnly"/>
        <TextField fx:id="searchField" promptText="%history.search" prefWidth="220"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%history.refresh" onAction="#refresh"/>
        <Button text="%history.clear" onAction="#clear" styleClass="danger"/>
    </HBox>
    <TableView fx:id="table" VBox.vgrow="ALWAYS">
        <placeholder><Label text="%history.empty" styleClass="muted"/></placeholder>
        <columns>
            <TableColumn fx:id="dateColumn" text="%history.col.date" prefWidth="140"/>
            <TableColumn fx:id="moduleColumn" text="%history.col.module" prefWidth="170"/>
            <TableColumn fx:id="actionColumn" text="%history.col.action" prefWidth="260"/>
            <TableColumn fx:id="fileColumn" text="%history.col.file" prefWidth="260"/>
            <TableColumn fx:id="resultColumn" text="%history.col.result" prefWidth="100"/>
        </columns>
    </TableView>
    <Label text="%history.privacy" styleClass="muted" wrapText="true"/>
    <Label fx:id="statusLabel" styleClass="status"/>
</VBox>
