<?xml version="1.0" encoding="UTF-8"?>

<!-- UI-04 Ανοιχτό θησαυροφυλάκιο: VLT-03 … VLT-10, VLT-13, VLT-14 -->
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="gr.ihu.omada12.crypto.controller.vault.VaultController"
      styleClass="screen" spacing="10">
    <padding><Insets top="16" right="20" bottom="16" left="20"/></padding>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="%vault.open" styleClass="muted"/>
        <Label fx:id="vaultNameLabel" styleClass="section-title"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="countLabel" styleClass="muted"/>
        <Button text="%vault.lock" onAction="#lock" styleClass="danger"/>
    </HBox>

    <HBox fx:id="actions" spacing="8">
        <Button text="%vault.add" onAction="#chooseFiles" styleClass="primary"/>
        <Button text="%vault.export" onAction="#exportSelected"/>
        <Button text="%vault.preview" onAction="#preview"/>
        <Button text="%vault.tag" onAction="#editTag"/>
        <Button text="%vault.delete" onAction="#deleteSelected"/>
        <Button text="%vault.changePassword" onAction="#changePassword"/>
    </HBox>

    <HBox spacing="8" alignment="CENTER_LEFT" styleClass="filter-bar">
        <TextField fx:id="searchField" promptText="%vault.search" prefWidth="220"/>
        <Label text="%vault.filter.type"/>
        <ComboBox fx:id="typeFilter" prefWidth="110"/>
        <Label text="%vault.filter.tag"/>
        <ComboBox fx:id="tagFilter" prefWidth="130"/>
        <Label text="%vault.filter.from"/>
        <DatePicker fx:id="fromDate" prefWidth="130"/>
        <Label text="%vault.filter.to"/>
        <DatePicker fx:id="toDate" prefWidth="130"/>
        <Button text="%vault.filter.clear" onAction="#clearFilters"/>
    </HBox>

    <TableView fx:id="table" VBox.vgrow="ALWAYS" styleClass="drop-target">
        <placeholder><Label text="%vault.empty" styleClass="muted"/></placeholder>
        <columns>
            <TableColumn fx:id="nameColumn" text="%vault.col.name" prefWidth="320"/>
            <TableColumn fx:id="typeColumn" text="%vault.col.type" prefWidth="80"/>
            <TableColumn fx:id="sizeColumn" text="%vault.col.size" prefWidth="100"/>
            <TableColumn fx:id="dateColumn" text="%vault.col.date" prefWidth="150"/>
            <TableColumn fx:id="tagColumn" text="%vault.col.tag" prefWidth="160"/>
        </columns>
    </TableView>
    <Label fx:id="statusLabel" styleClass="status"/>
</VBox>
